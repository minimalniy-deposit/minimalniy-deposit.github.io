  <script>
    // Bankroll & bonus calculator — runs locally, no network.
    const form = document.querySelector<HTMLFormElement>('form.calc');
    const out = form?.querySelector<HTMLOutputElement>('.calc-out');
    const fmt = (n: number, d = 0) => n.toLocaleString('ru-RU', { maximumFractionDigits: d, minimumFractionDigits: d });
    const calc = () => {
      if (!form || !out) return;
      const v = (n: string) => parseFloat((form.elements.namedItem(n) as HTMLInputElement).value) || 0;
      const dep = v('dep'), bet = v('bet'), rtp = v('rtp') / 100, pct = v('pct'), wager = v('wager'), maxbet = v('maxbet');
      if (dep <= 0 || bet <= 0) { out.textContent = ''; return; }
      const spins = Math.floor(dep / bet), lossSpin = bet * (1 - rtp), share = (bet / dep) * 100;
      const bonus = dep * pct / 100, turn = bonus * wager, cost = turn * (1 - rtp), ev = bonus - cost;
      const spinsMax = maxbet > 0 ? Math.ceil(turn / maxbet) : 0, spinsBet = Math.ceil(turn / bet);
      out.innerHTML =
        `<b>Сессия:</b> ${fmt(spins)} спинов по номиналу, ставка ${fmt(share, 1)}% банкролла, ожидаемый проигрыш ${fmt(lossSpin, 2)} ₽ за спин (${fmt(lossSpin * 100)} ₽ на 100 спинов).` +
        (bonus > 0 ? `<br><b>Бонус:</b> ${fmt(bonus)} ₽, оборот ${fmt(turn)} ₽, ожидаемая стоимость отыгрыша ${fmt(cost)} ₽ → EV ${ev >= 0 ? '+' : ''}${fmt(ev)} ₽. Спинов до конца отыгрыша: ${fmt(spinsBet)} при вашей ставке, не меньше ${fmt(spinsMax)} при потолке ${fmt(maxbet)} ₽.` : '');
    };
    form?.addEventListener('input', calc); calc();
  </script>
