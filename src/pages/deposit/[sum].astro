---
import Base from '../../layouts/Base.astro';
import { casinos, type Casino } from '../../lib/casinos';
import { lastChecked } from '../../lib/history';
import { rates, bc, hasRates, toUsdt, rateDate, fmtRub } from '../../lib/rates';
import { formatMoney } from '../../i18n';

export function getStaticPaths() {
  return [100, 500, 1000].map((sum) => ({ params: { sum: String(sum) }, props: { sum } }));
}
const { sum } = Astro.props as { sum: number };
const SUMS = [100, 500, 1000] as const;

/* ---------- data ---------- */
const fits = casinos.filter((c) => c.minDeposit != null && c.minDeposit <= sum).sort((a, b) => a.rank - b.rank);
const exact = fits.filter((c) => c.minDeposit === sum);
const fastest = [...fits].sort((a, b) => a.withdrawMin! - b.withdrawMin! || a.rank - b.rank)[0];
const isCrypto = (c: Casino) => c.payments.some((p) => ['usdt', 'btc', 'crypto'].includes(p));
const cryptoFits = fits.filter(isCrypto);

const rub = (n: number, d = 0) => n.toLocaleString('ru-RU', { maximumFractionDigits: d, minimumFractionDigits: d }).replace(/\u00a0/g, ' ').replace(/^-/, '−');
const plural = (n: number, one: string, few: string, many: string) => { const a = n % 10, b = n % 100; return n === 1 ? one : (a >= 2 && a <= 4 && (b < 10 || b >= 20)) ? few : many; };
const names = (l: Casino[]) => l.map((c) => c.name.replace(' Casino', '')).join(', ');
const fmtD = (d: string) => new Date(d).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }).replace(' г.', '');

/* ---------- session maths (RTP 96% baseline; casino RTP where known) ---------- */
const RTP = 0.96;
const bets = sum === 100 ? [1, 2, 5, 10] : sum === 500 ? [2, 5, 10, 25] : [5, 10, 25, 50];
const sessionRows = bets.map((b) => ({ bet: b, spins: Math.floor(sum / b), lossPerSpin: b * (1 - RTP), loss100: 100 * b * (1 - RTP), pctBank: (b / sum) * 100 }));
const stake1pct = sum / 100;
const usd = rates.usd ?? null;
const minBetPragmatic = usd ? 0.2 * usd : null;   // Gates of Olympus / Sweet Bonanza: $0.20
const minBetStarburst = usd ? 0.1 * usd : null;   // Starburst / Book of Dead: $0.10

/* ---------- bonus economics ---------- */
const pct = (c: Casino) => { const m = (c.bonus ?? '').match(/(\d{2,3})%/); return m && +m[1] >= 50 ? +m[1] : null; };
const fs = (c: Casino) => { const m = (c.bonus ?? '').match(/(\d+)\s*фриспин/); return m ? +m[1] : null; };
const bonusRub = (c: Casino) => (pct(c) != null ? Math.round(sum * pct(c)! / 100) : null);
const turnover = (c: Casino) => (bonusRub(c) != null && c.wager != null ? bonusRub(c)! * c.wager : null);
const turnoverDB = (c: Casino) => (bonusRub(c) != null && c.wager != null ? (sum + bonusRub(c)!) * c.wager : null);
const edge = (c: Casino) => 1 - ((c.rtp ?? 96) / 100);
const ev = (c: Casino) => (turnover(c) != null ? Math.round(bonusRub(c)! - turnover(c)! * edge(c)) : null);
const withMath = fits.filter((c) => turnover(c) != null);
const MAX_BET = 500; // typical max bet while wagering, ₽ (≈ $5)
const spinsAtMaxBet = (c: Casino) => Math.ceil(turnover(c)! / MAX_BET);
const spinsAt1pct = (c: Casino) => Math.ceil(turnover(c)! / stake1pct);
const w0 = withMath[0];

/* ---------- payments ---------- */
const trcFeeRub = usd ? [1.95 * usd, 3.9 * usd] : null;        // TRC-20 fee after Tron Proposal #104 (Aug 2025): ~$1.95–3.90
const casinoCryptoMinRub = bc ? 10 * bc.rubPerUsdt : null;      // typical casino minimum 10 USDT
const cryptoVerdict = sum === 100 ? 'невозможно' : sum === 500 ? 'на грани' : 'работает';
const sumUsdt = hasRates ? toUsdt(sum) : null;

/* ---------- copy ---------- */
const H1: Record<number, string> = {
  100: 'Депозит 100 рублей: тест площадки, а не игровая сессия',
  500: 'Депозит 500 рублей: минимальный рабочий банкролл',
  1000: 'Депозит 1 000 рублей: порог, на котором включается всё',
};
const TITLE: Record<number, string> = {
  100: `Депозит 100 рублей в казино: ${exact.length} ${plural(exact.length, 'площадка', 'площадки', 'площадок')} рейтинга, сколько это спинов, почему бонус не брать и чем платить`,
  500: `Депозит 500 рублей в казино: ${fits.length} из ${casinos.length} площадок, расчёт бонуса и оборота, крипта на грани, чем платить`,
  1000: `Депозит 1 000 рублей в казино: все ${fits.length} площадок, EV бонуса, крипто-депозит, лимиты вывода и KYC`,
};
const LEDE: Record<number, string> = {
  100: 'Сто рублей — это возможность проверить кассу, скорость вывода и слоты площадки за цену чашки кофе. Игровой сессией это становится только при ставке в рубль и слоте с низкой волатильностью.',
  500: 'Пятьсот рублей — первая сумма, на которой работает банкролл-менеджмент: ставка 5 рублей, сто спинов, часть бонусов открыта — и математика бонуса впервые заслуживает расчёта.',
  1000: 'Тысяча снимает последний порог: принимает каждая площадка рейтинга, доступен крипто-депозит, а бонус — вопрос расчёта оборота против правила максимальной ставки.',
};

const lead = sum === 1000
  ? `На ${rub(sum)} рублей принимают все ${fits.length} площадок рейтинга; порог ровно ${rub(sum)} — только у ${names(exact)}`
  : exact.length === fits.length
    ? `${rub(sum)} рублей — минимальный порог у ${fits.length} из ${casinos.length} площадок рейтинга: ${names(exact)}`
    : `${rub(sum)} рублей принимают ${fits.length} из ${casinos.length} площадок рейтинга; для ${exact.length} из них это минимальный порог — ${names(exact)}`;
const answer = `${lead}. При ставке 1% банкролла (${rub(stake1pct)} ₽) это ${rub(Math.floor(sum / stake1pct))} спинов, а математическое ожидание проигрыша на слоте с RTP 96% — ${rub(stake1pct * (1 - RTP), 2)} ₽ за спин. ${w0 ? `Бонус у ${w0.name.replace(' Casino', '')} — ${rub(bonusRub(w0)!)} ₽ при обороте ${rub(turnover(w0)!)} ₽; его математическое ожидание ${ev(w0)! < 0 ? `отрицательно (${rub(ev(w0)!)} ₽)` : `${rub(ev(w0)!)} ₽`}${sum === 100 ? ' — на сотне бонус не брать' : sum === 500 ? ' — брать только при регулярной игре на низкой волатильности' : ' — решает правило максимальной ставки, а не размер бонуса'}.` : ''} Крипто-депозит на эту сумму ${sum === 100 ? 'невозможен' : cryptoVerdict}${sum === 100 ? ': сетевой сбор и минимумы обменников больше самого депозита' : sum === 500 ? ': сбор сети съедает до 7%, а обменники меняют от бо́льших сумм' : casinoCryptoMinRub ? `: минимум кассы 10 USDT ≈ ${rub(casinoCryptoMinRub)} ₽ укладывается` : ''}. Быстрее всех выводит ${fastest.name} — от ${fastest.withdrawMin} минут через СБП. Сверено ${fmtD(lastChecked)}.`;

const description = `${LEDE[sum]} ${fits.length} площадок с условиями, ожидаемый проигрыш по ставкам, EV бонуса, СБП против карты и крипты, минимумы вывода, инструменты ответственной игры.`;

/* ---------- FAQ (also marked up) ---------- */
const faq: { q: string; a: string }[] = sum === 100 ? [
  { q: 'Сколько спинов даёт депозит 100 рублей?', a: `При ставке 1 ₽ — около 100 вращений по номиналу, при 2 ₽ — 50, при 5 ₽ — 20. На слотах Pragmatic Play минимальная ставка $0,20${minBetPragmatic ? ` (≈ ${rub(minBetPragmatic)} ₽)` : ''}, поэтому Gates of Olympus или Sweet Bonanza дадут лишь 5–6 спинов. Для сотни подходят слоты с минимумом $0,10 и низкой волатильностью — Starburst, Blood Suckers.` },
  { q: 'Стоит ли брать бонус на 100 рублей?', a: w0 ? `Нет. ${w0.name.replace(' Casino', '')} даёт ${rub(bonusRub(w0)!)} ₽ бонуса при обороте ${rub(turnover(w0)!)} ₽ — это ${rub(spinsAt1pct(w0))} спинов по 1 ₽, а ожидаемая стоимость отыгрыша ${rub(turnover(w0)! * edge(w0))} ₽ превышает сам бонус. К тому же у большинства площадок порог бонуса — 500–1 000 ₽. Откажитесь от бонуса в кассе и, если предлагают, возьмите кешбэк.` : 'Нет: порог бонуса у большинства площадок 500–1 000 ₽, а оборот по вейджеру в десятки раз превышает сотню.' },
  { q: 'Можно ли внести 100 рублей криптовалютой?', a: `Практически нет. Сетевой сбор USDT TRC-20 — ${trcFeeRub ? `${rub(trcFeeRub[0])}–${rub(trcFeeRub[1])} ₽` : 'около 2–4 долларов'}, обменники на BestChange меняют от ${bc ? `${rub(bc.minSum)} ₽` : 'тысячи рублей'}, а кассы казино принимают крипту обычно от 10 USDT${casinoCryptoMinRub ? ` (≈ ${rub(casinoCryptoMinRub)} ₽)` : ''}. Для сотни — только СБП или карта «Мир».` },
  { q: 'Сколько можно вывести с депозита 100 рублей?', a: 'Минимум вывода у площадок обычно 300–1 000 ₽ — он выше минимума пополнения. Выигрыш меньше порога останется на балансе. Выводить можно только тем же способом, которым пополняли, — это требование по борьбе с отмыванием, а не прихоть казино.' },
] : sum === 500 ? [
  { q: 'Какую ставку выбрать на 500 рублей?', a: `Правило 1–2% банкролла даёт 5–10 ₽ за спин: 50–100 вращений. При ставке 5 ₽ ожидаемый проигрыш — 0,20 ₽ за спин, 20 ₽ на сотню спинов при RTP 96%. На высокой волатильности та же сумма может закончиться вдвое быстрее — сессию определяет дисперсия, а не RTP.` },
  { q: 'Выгоден ли бонус на 500 рублей?', a: withMath.length ? `Считайте: ${withMath.slice(0, 2).map((c) => `${c.name.replace(' Casino', '')} — бонус ${rub(bonusRub(c)!)} ₽, оборот ${rub(turnover(c)!)} ₽, математическое ожидание ${rub(ev(c)!)} ₽`).join('; ')}. При вейджере x30–x40 бонус почти всегда в минусе на дистанции; он оправдан только для регулярной игры на низкой волатильности и при ставке не выше разрешённой во время отыгрыша (обычно ${rub(MAX_BET)} ₽).` : 'При вейджере x30–x40 бонус почти всегда в минусе на дистанции.' },
  { q: 'Можно ли внести 500 рублей в USDT?', a: `На грани. Сетевой сбор TRC-20 — ${trcFeeRub ? `${rub(trcFeeRub[0])}–${rub(trcFeeRub[1])} ₽ (до ${rub(trcFeeRub[1] / sum * 100)}% от суммы)` : 'около 2–4 долларов'}, лучший обменник для небольших сумм на BestChange меняет от ${bc ? `${rub(bc.minSum)} ₽` : 'тысячи рублей'}. Практичнее СБП: без комиссии и за секунды.` },
  { q: 'Что открывается на 500 рублей, чего нет на 100?', a: `У ${names(exact)} порог входа — ровно 500: здесь турниры и увеличенные пакеты. Это же обычный порог активации бонусов у площадок, которые кассой принимают и 100.` },
] : [
  { q: 'Сколько спинов даёт 1 000 рублей и какая ставка правильная?', a: `Ставка 1% — 10 ₽ — даёт 100 спинов при ожидаемом проигрыше 0,40 ₽ за спин; ставка 5 ₽ — 200 спинов. Это первая сумма, на которой можно осознанно выбирать волатильность под цель: низкую для долгой сессии, высокую — ради шанса на крупный множитель.` },
  { q: 'Брать ли бонус на 1 000 рублей?', a: withMath.length ? `Решает не размер, а правило максимальной ставки. ${w0!.name.replace(' Casino', '')}: бонус ${rub(bonusRub(w0!)!)} ₽, оборот ${rub(turnover(w0!)!)} ₽ — при потолке ${rub(MAX_BET)} ₽ за спин это минимум ${rub(spinsAtMaxBet(w0!))} спинов, при ставке 10 ₽ — ${rub(spinsAt1pct(w0!))}. Математическое ожидание — ${rub(ev(w0!)!)} ₽. Если вейджер считается от суммы «депозит + бонус», оборот вырастает до ${rub(turnoverDB(w0!)!)} ₽ — уточняйте в правилах.` : 'Решает правило максимальной ставки и срок отыгрыша.' },
  { q: 'Как внести 1 000 рублей криптовалютой?', a: `Купить USDT у обменника с BestChange (лучший курс для небольших сумм — ${bc ? `${rub(bc.rubPerUsdt, 2)} ₽, от ${rub(bc.minSum)} ₽` : 'см. таблицу способов'}), учесть сетевой сбор TRC-20 ${trcFeeRub ? `${rub(trcFeeRub[0])}–${rub(trcFeeRub[1])} ₽` : ''} и минимум кассы 10 USDT${casinoCryptoMinRub ? ` ≈ ${rub(casinoCryptoMinRub)} ₽` : ''}. Тысяча укладывается впритык; СБП по-прежнему дешевле и быстрее.` },
  { q: 'Потребуют ли документы при выводе?', a: 'Первые выводы небольших сумм — обычно до 5 000–15 000 ₽ — проходят без паспорта. По правилам лицензии Кюрасао оператор обязан провести верификацию при достижении порога транзакций (отраслевая оценка — около 2 000–2 500 евро) и вправе запросить документы раньше при подозрительной активности. Тысяча депозита к порогу не приближает.' },
];

/* ---------- structured data ---------- */
const path = `/deposit/${sum}/`;
const url = new URL(path, Astro.site).href;
const ld = [
  { '@context': 'https://schema.org', '@type': 'WebPage', '@id': url + '#webpage', name: TITLE[sum], url, description, inLanguage: 'ru', dateModified: lastChecked,
    breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: `Депозит ${rub(sum)} ₽`, item: url } ] },
    mainEntity: { '@id': url + '#question' }, hasPart: [{ '@id': url + '#list' }, { '@id': url + '#faq' }],
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.answer-first'] } },
  { '@context': 'https://schema.org', '@type': 'QAPage', '@id': url + '#qa', url,
    mainEntity: { '@type': 'Question', '@id': url + '#question', name: `Какие казино принимают депозит ${rub(sum)} рублей и что он реально даёт?`, answerCount: 1, dateModified: lastChecked,
      acceptedAnswer: { '@type': 'Answer', text: answer, url, dateModified: lastChecked } } },
  { '@context': 'https://schema.org', '@type': 'ItemList', '@id': url + '#list', name: `Казино с депозитом от ${rub(sum)} ₽`, url, numberOfItems: fits.length,
    itemListElement: fits.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: `${c.name} — от ${rub(c.minDeposit!)} ₽`, url: new URL(`/casino/${c.slug}/`, Astro.site).href })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', '@id': url + '#faq', url,
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base locale="ru" {path} title={TITLE[sum]} {description} translated={false}>
  <Fragment slot="head">{ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}</Fragment>
  <div class="container">
    <nav class="crumbs" aria-label="breadcrumb"><ol><li><a href="/">Главная</a></li><li aria-current="page">Депозит {rub(sum)} ₽</li></ol></nav>
    <div class="page-head">
      <h1>{H1[sum]}</h1>
      <p class="lede answer-first">{answer}</p>
    </div>

    <nav class="filters" role="group" aria-label="Порог депозита" style="margin-bottom:24px">
      {SUMS.map((s) => <a class:list={['filter-btn', { active: s === sum }]} href={`/deposit/${s}/`} aria-current={s === sum ? 'page' : undefined}>{rub(s)} ₽</a>)}
      <a class="filter-btn" href="/#rating">весь рейтинг</a>
    </nav>

    <!-- 1. Площадки -->
    <section id="casinos">
      <h2 class="section-title" style="font-size:1.25rem">Кто принимает {rub(sum)} ₽ и на каких условиях</h2>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th>#</th><th>Казино</th><th>Мин. депозит</th><th>Вывод</th><th>Пополнение</th><th>RTP</th><th>Бонус на {rub(sum)} ₽</th><th>Оборот</th><th title="Математическое ожидание бонуса после отыгрыша">EV бонуса</th></tr></thead>
          <tbody>{fits.map((c) => (
            <tr class:list={{ me: c.minDeposit === sum }}>
              <td class="num">{c.rank}</td>
              <td><a href={`/casino/${c.slug}/`}>{c.name}</a></td>
              <td class="num">{formatMoney(c.minDeposit!)}</td>
              <td class="num">от {c.withdrawMin} мин</td>
              <td>{c.paymentsLabel}</td>
              <td class="num">{c.rtp != null ? `${c.rtp.toFixed(1)}%` : '—'}</td>
              <td class="num">{bonusRub(c) != null ? `${pct(c)}% → ${rub(bonusRub(c)!)} ₽` : fs(c) ? `${fs(c)} FS` : '—'}</td>
              <td class="num">{turnover(c) != null ? `${rub(turnover(c)!)} ₽ · x${c.wager}` : c.wager ? `x${c.wager}` : '—'}</td>
              <td class:list={['num', { ok: ev(c) != null && ev(c)! > 0, no: ev(c) != null && ev(c)! <= 0 }]} style="color:var(--text)">{ev(c) != null ? `${ev(c)! > 0 ? '+' : ''}${rub(ev(c)!)} ₽` : '—'}</td>
            </tr>))}</tbody>
        </table>
      </div>
      <p class="section-sub" style="margin-top:10px">Выделены площадки, у которых {rub(sum)} ₽ — минимальный порог кассы. Оборот = бонус × вейджер. EV = бонус − оборот × (1 − RTP): сколько бонус в среднем принесёт или отнимет после полного отыгрыша; RTP площадки, где он не раскрыт, принят за 96%. Прочерк — площадка не публикует размер бонуса или вейджер в открытых правилах.</p>
    </section>

    <!-- 2. Сессия -->
    <section id="session" class="prose" style="padding-top:32px">
      <h2>Сколько это спинов — и сколько стоит каждый</h2>
      <p>Ожидаемый проигрыш за спин равен ставке, умноженной на долю, которую слот оставляет себе: при RTP 96% это 4% ставки. Цифра описывает не вашу сессию, а среднее по миллиардам вращений — на дистанции в сто спинов результат определяет дисперсия. Но именно она задаёт честную цену развлечения: сколько вы платите за час игры.</p>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th>Ставка</th><th>% банкролла</th><th>Спинов по номиналу</th><th>Ожидаемый проигрыш за спин</th><th>За 100 спинов</th></tr></thead>
          <tbody>{sessionRows.map((r) => (
            <tr class:list={{ me: r.bet === stake1pct }}>
              <td class="num">{rub(r.bet)} ₽</td>
              <td class="num">{rub(r.pctBank, 1)}%</td>
              <td class="num">{rub(r.spins)}</td>
              <td class="num">{rub(r.lossPerSpin, 2)} ₽</td>
              <td class="num">{rub(r.loss100)} ₽</td>
            </tr>))}</tbody>
        </table>
      </div>
      <p>Выделена ставка в 1% банкролла — нижняя граница общепринятого диапазона 1–5%; для маленькой суммы и высокой волатильности берут именно её. «Спинов по номиналу» — это банкролл, делённый на ставку; реальная сессия при низкой волатильности длиннее (часть ставок возвращается), при высокой — часто короче из-за длинных серий пустых вращений.</p>
