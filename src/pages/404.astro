---
import Base from '../layouts/Base.astro';
import { useT } from '../i18n';
const t = useT('ru');
---
<Base locale="ru" path="/404/" title={t.notFound.title} description={t.notFound.text} translated={false} noindex>
  <div class="container" style="padding:64px 0">
    <h1 style="font-size:2rem;font-weight:800">404 — {t.notFound.title}</h1>
    <p style="color:var(--muted);margin:12px 0 20px">{t.notFound.text} / Page not found.</p>
    <a class="btn-go" href="/">{t.notFound.link}</a> &nbsp; <a class="btn-go" href="/en/">Home (EN)</a>
  </div>
</Base>
