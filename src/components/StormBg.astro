---
/** Storm behind smoked glass. Glows drift on transform/opacity; bolts are procedural SVG that draw in, re-strike and fade.
 *  Each bolt lives in a long cycle and is invisible >96% of the time. Reduced-motion: static glows, no bolts. */
import { bolt } from '../lib/lightning';
interface Props { seeds?: number[]; intensity?: 'calm' | 'normal' }
const { seeds = [7, 23, 41], intensity = 'normal' } = Astro.props;
const bolts = seeds.map((s) => bolt(s));
const place = [{ left: '-3%', dur: 29, delay: 4, h: '54%', color: 'cool' }, { left: '86%', dur: 41, delay: 19, h: '50%', color: 'warm' }, { left: '4%', dur: 53, delay: 33, h: '42%', color: 'cool' }];
---
<div class:list={['storm', intensity]} aria-hidden="true">
  <div class="glow g-blue"></div>
  <div class="glow g-amber"></div>
  {bolts.map((b, i) => (
    <svg class:list={['bolt', place[i].color]} viewBox={`0 0 ${b.w} ${b.h}`} preserveAspectRatio="xMidYMin meet"
         style={`left:${place[i].left};height:${place[i].h};animation-duration:${place[i].dur}s;animation-delay:-${place[i].delay}s`}>
      <defs><radialGradient id={`f${i}`}><stop offset="0" stop-color="currentColor" stop-opacity=".9" /><stop offset="1" stop-color="currentColor" stop-opacity="0" /></radialGradient></defs>
      <ellipse class="flash" cx={b.x0} cy="0" rx="150" ry="120" fill={`url(#f${i})`} />
      <path class="halo" d={b.main} pathLength="1" />
      {b.branches.map((d) => <path class="branch" d={d} pathLength="1" />)}
      <path class="main" d={b.main} pathLength="1" />
    </svg>
  ))}
</div>
<style>
  .storm { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
  .glow { position: absolute; border-radius: 50%; filter: blur(70px); will-change: transform, opacity; mix-blend-mode: screen; }
  .g-blue { width: 52vw; height: 52vw; min-width: 460px; min-height: 460px; left: -16%; top: -22%; background: radial-gradient(circle, rgba(111,176,255,.42), rgba(111,176,255,.10) 42%, transparent 68%); animation: driftA 44s ease-in-out infinite alternate; }
  .g-amber { width: 44vw; height: 44vw; min-width: 400px; min-height: 400px; right: -16%; bottom: -26%; background: radial-gradient(circle, rgba(240,170,60,.42), rgba(240,170,60,.10) 42%, transparent 68%); animation: driftB 52s ease-in-out infinite alternate; }
  .calm .glow { opacity: .7; }
  @keyframes driftA { from { transform: translate3d(0,0,0) scale(1); } 50% { transform: translate3d(5vw, 3vh, 0) scale(1.1); } to { transform: translate3d(-3vw, 7vh, 0) scale(.96); } }
  @keyframes driftB { from { transform: translate3d(0,0,0) scale(1); } 50% { transform: translate3d(-6vw, -4vh, 0) scale(1.12); } to { transform: translate3d(3vw, -8vh, 0) scale(.94); } }

  .bolt { position: absolute; top: -4%; opacity: .85; width: auto; overflow: visible; animation-name: cycle; animation-timing-function: linear; animation-iteration-count: infinite; }
  .bolt.cool { color: #bfe0ff; } .bolt.warm { color: #ffd39a; }
  .bolt path { fill: none; stroke: currentColor; stroke-linejoin: round; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; opacity: 0; }
  .bolt .main { stroke-width: 1.4; }
  .bolt .halo { stroke-width: 7; opacity: 0; filter: blur(4px); }
  .bolt .branch { stroke-width: .9; }
  .bolt .flash { opacity: 0; }
  /* The whole bolt group is driven by one cycle; children read the group's progress via inherited animation timing:
     we animate each child with the same duration/delay via inherit, so percentages line up. */
  .bolt .main, .bolt .halo, .bolt .branch, .bolt .flash { animation-duration: inherit; animation-delay: inherit; animation-iteration-count: infinite; animation-timing-function: linear; }
  .bolt .main { animation-name: strike; } .bolt .halo { animation-name: halo; } .bolt .branch { animation-name: branch; } .bolt .flash { animation-name: flash; }
  @keyframes cycle { from { opacity: 1; } to { opacity: 1; } }
  /* event window: 0–3.2% of the cycle (~1s of 30s). draw 0–0.5%, hold, re-strike at 1.3% and 2.1%, fade by 3.2% */
  @keyframes strike {
    0% { stroke-dashoffset: 1; opacity: 0; } 0.05% { opacity: 1; } 0.5% { stroke-dashoffset: 0; opacity: 1; }
    0.9% { opacity: .25; } 1.3% { opacity: 1; } 1.7% { opacity: .2; } 2.1% { opacity: .85; } 3.2% { opacity: 0; stroke-dashoffset: 0; } 100% { opacity: 0; stroke-dashoffset: 0; } }
  @keyframes halo {
    0% { stroke-dashoffset: 1; opacity: 0; } 0.5% { stroke-dashoffset: 0; opacity: .55; } 0.9% { opacity: .1; } 1.3% { opacity: .5; } 2.1% { opacity: .35; } 3.4% { opacity: 0; } 100% { opacity: 0; } }
  @keyframes branch {
    0%, 0.3% { stroke-dashoffset: 1; opacity: 0; } 0.35% { opacity: .9; } 0.7% { stroke-dashoffset: 0; opacity: .9; } 1.0% { opacity: .15; } 1.35% { opacity: .7; } 2.6% { opacity: 0; stroke-dashoffset: 0; } 100% { opacity: 0; stroke-dashoffset: 0; } }
  @keyframes flash {
    0% { opacity: 0; } 0.3% { opacity: .9; } 0.9% { opacity: .15; } 1.3% { opacity: .7; } 2.2% { opacity: .3; } 3.6% { opacity: 0; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .glow { animation: none; } .bolt { display: none; } }
  @media (max-width: 720px) { .glow { filter: blur(48px); } .bolt:nth-child(4) { display: none; } }
</style>
