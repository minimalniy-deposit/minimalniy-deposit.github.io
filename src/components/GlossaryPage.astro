---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import glossary from '../data/glossary.json';
import { casinos } from '../lib/casinos';
import { useT, localePath, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale); const ru = locale === 'ru';
const home = localePath(locale, '/');
const url = new URL(localePath(locale, '/glossary/'), Astro.site).href;
// Where a term is used: casinos with a value for that field
const usedIn: Record<string, typeof casinos> = {
  rtp: casinos.filter((c) => c.rtp != null), wager: casinos.filter((c) => c.wager != null), cashback: casinos.filter((c) => c.cashback != null),
  sbp: casinos.filter((c) => c.payments.includes('sbp')), 'min-deposit': casinos.filter((c) => c.minDeposit === 100),
};
const ld = { '@context': 'https://schema.org', '@type': 'DefinedTermSet', name: t.glossary.h1, url, inLanguage: locale,
  hasDefinedTerm: glossary.map((g) => ({ '@type': 'DefinedTerm', name: ru ? g.term : g.termEn, description: ru ? g.def : g.defEn, url: `${url}#${g.slug}` })) };
const ldPage = { '@context': 'https://schema.org', '@type': 'WebPage', name: t.glossary.title, url, description: t.glossary.metaDesc, inLanguage: locale, dateModified: site.lastVerified,
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [ { '@type': 'ListItem', position: 1, name: t.casino.breadcrumbHome, item: new URL(home, Astro.site).href }, { '@type': 'ListItem', position: 2, name: t.glossary.breadcrumb, item: url } ] } };
---
<Base {locale} path="/glossary/" title={t.glossary.title} description={t.glossary.metaDesc}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(ldPage)} /><script type="application/ld+json" set:html={JSON.stringify(ld)} /></Fragment>
  <div class="container">
    <nav class="crumbs" aria-label="breadcrumb"><ol><li><a href={home}>{t.casino.breadcrumbHome}</a></li><li aria-current="page">{t.glossary.breadcrumb}</li></ol></nav>
    <div class="page-head"><h1>{t.glossary.h1}</h1><p class="lede">{t.glossary.lede}</p></div>
    <dl class="gloss" style="padding-bottom:48px">
      {glossary.map((g) => (
        <div class="gloss-item" id={g.slug}>
          <dt><a href={`#${g.slug}`}>{ru ? g.term : g.termEn}</a></dt>
          <dd>{ru ? g.def : g.defEn}</dd>
          {usedIn[g.slug]?.length > 0 && <dd class="gloss-used">{t.glossary.usedIn}: {usedIn[g.slug].slice(0, 6).map((c, i) => <><a href={localePath(locale, `/casino/${c.slug}/`)}>{c.name}</a>{i < Math.min(usedIn[g.slug].length, 6) - 1 ? ', ' : ''}</>)}</dd>}
        </div>
      ))}
    </dl>
  </div>
</Base>
