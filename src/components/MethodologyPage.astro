---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { casinos } from '../lib/casinos';
import { useT, localePath, type Locale } from '../i18n';
import { minDepositIndex, svgLine } from '../lib/charts';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);
const ru = locale === 'ru';
const home = localePath(locale, '/');
const verifiedHuman = new Date(site.lastVerified).toLocaleDateString(ru ? 'ru-RU' : 'en-GB');
const updatedHuman = new Date(site.contentUpdated).toLocaleDateString(ru ? 'ru-RU' : 'en-GB');

// Live numbers from the same data the cards are built from.
const n = casinos.length;
const from100 = casinos.filter((c) => c.minDeposit === 100).length;
const fast15 = casinos.filter((c) => c.withdrawMin != null && c.withdrawMin <= 15).length;
const withRtp = casinos.filter((c) => c.rtp != null);
const bestRtp = [...withRtp].sort((a, b) => b.rtp! - a.rtp!)[0];
const wagers = casinos.filter((c) => c.wager != null).map((c) => c.wager!);
const minWager = Math.min(...wagers), maxWager = Math.max(...wagers);

const weights: [string, number, string][] = ru
  ? [
    ['Скорость первого вывода', 35, 'Отсчёт идёт от нажатия кнопки «Вывести» до поступления денег через СБП. До 15 минут — высший балл, около получаса — половина. Если ожидание превышает час, а поддержка не объясняет причину, площадка не теряет баллы, а покидает список.'],
    ['Условия бонуса', 25, 'Оцениваем не размер, а условия: вейджер, срок отыгрыша, предельную ставку и порог вывода. Вейджер выше x40 или правила, до которых от кассы не добраться за два шага, обнуляют этот критерий.'],
    ['Лицензия и игры', 20, 'Номер лицензии сверяем с реестром регулятора, а не с подвалом сайта. Проверяем, что слоты запускаются с серверов провайдера, — подделку выдаёт адрес, с которого загружается игра.'],
    ['Порог входа и касса', 10, 'Принимает ли касса 100 рублей без оговорки «для бонуса — от 500» мелким шрифтом, работают ли СБП и карты «Мир», нет ли комиссии за вывод небольших сумм.'],
    ['Поддержка и мобильная версия', 10, 'Ответ в чате на русском языке в течение пяти минут, столы с живыми дилерами в мобильной сети, пополнение с телефона без сбоев.'],
  ]
  : [
    ['First-withdrawal speed', 35, 'Measured from tapping "Withdraw" to money landing via SBP. Under 15 minutes scores full marks, 30 minutes half; over an hour with no explanation removes the casino from the list rather than costing points.'],
    ['Bonus fairness', 25, 'Terms, not size: wagering, deadline, max bet while wagering, withdrawal threshold. Wagering above 40x, or terms buried more than two clicks from the cashier, zero this criterion.'],
    ['Licence and software', 20, "We check the licence number against the regulator's registry, not the footer, and confirm slots load from the provider's server — fakes show in the game-frame URL."],
    ['Entry threshold and cashier', 10, 'Does the cashier take 100 ₽ without a "minimum 500 for the bonus" in small print, are SBP and MIR cards there, is there a fee on small withdrawals.'],
    ['Support and mobile', 10, 'A chat reply in Russian within five minutes, live tables on 4G, an app or PWA that deposits from a phone without errors.'],
  ];

const idx = minDepositIndex();
const idxSvg = svgLine(idx.map((p) => [p.date, p.avg]), { unit: ' ₽', title: t.fresh.index });
const url = new URL(localePath(locale, '/methodology/'), Astro.site).href;
const ld = {
  '@context': 'https://schema.org', '@type': 'WebPage', name: t.methodology.title, url, description: t.methodology.metaDesc, inLanguage: locale, dateModified: site.lastVerified,
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.casino.breadcrumbHome, item: new URL(home, Astro.site).href },
    { '@type': 'ListItem', position: 2, name: t.methodology.h1, item: url },
  ] },
};
---
<Base {locale} path="/methodology/" title={t.methodology.title} description={t.methodology.metaDesc}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(ld)} /></Fragment>
  <div class="container">
    <nav class="crumbs" aria-label="breadcrumb"><ol><li><a href={home}>{t.casino.breadcrumbHome}</a></li><li aria-current="page">{t.methodology.h1}</li></ol></nav>
    <div class="page-head">
      <h1>{t.methodology.h1}</h1>
      <p class="lede">{ru
        ? `Место в рейтинге нельзя купить: это таблица из ${n} площадок, упорядоченная по формуле, которую можно проверить. Ниже — вес каждого критерия, порядок проверки и причины, по которым казино покидает список.`
        : `The rating is not "who pays most for a slot" but a table of ${n} casinos sorted by a formula you can check. Below: the criteria weights, what we do on a check day, and what gets a casino removed.`}</p>
    </div>

    <div class="callouts">
      <div class="callout"><b>{from100}</b> {ru ? `из ${n} площадок принимают 100 рублей` : `of ${n} casinos accept 100 ₽`}</div>
      <div class="callout"><b>{fast15}</b> {ru ? 'выплачивают не дольше 15 минут' : 'pay out within 15 minutes'}</div>
      <div class="callout"><b>x{minWager}–x{maxWager}</b> {ru ? 'диапазон вейджера в рейтинге' : 'wagering range in the rating'}</div>
      {bestRtp && <div class="callout"><b>{bestRtp.rtp!.toFixed(1)}%</b> {ru ? 'самый высокий заявленный RTP — ' : 'best declared RTP — '}<a href={localePath(locale, `/casino/${bestRtp.slug}/`)}>{bestRtp.name}</a></div>}
    </div>

    {idxSvg && <section style="margin:8px 0 8px"><h2 class="section-title" style="font-size:1.1rem">{t.fresh.index}: {idx[idx.length - 1].avg} ₽</h2><p class="section-sub">{t.fresh.indexSub} ({idx[idx.length - 1].n} {ru ? 'площадок' : 'casinos'})</p><Fragment set:html={idxSvg} /></section>}
    <div class="prose" style="padding-bottom:48px">
      <h2>{ru ? 'Из чего складывается оценка' : 'What makes up the score'}</h2>
      <p>{ru
        ? 'Пять критериев, и у каждого свой вес. Оценка в карточке — взвешенная сумма по десятибалльной шкале. Поэтому казино с щедрым бонусом, но медленными выплатами не обгонит площадку со скромным бонусом и быстрым выводом.'
        : 'Five criteria with different weights. The score in a card is the weighted sum on a 10-point scale, so a casino with a generous bonus but slow payouts never overtakes a modest but fast one.'}</p>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th>{ru ? 'Критерий' : 'Criterion'}</th><th>{ru ? 'Вес' : 'Weight'}</th><th>{ru ? 'Что проверяем' : 'What exactly we check'}</th></tr></thead>
          <tbody>{weights.map(([name, w, desc]) => <tr><td><b>{name}</b></td><td class="num"><b style="color:var(--gold)">{w}%</b></td><td style="white-space:normal;color:var(--muted);min-width:260px">{desc}</td></tr>)}</tbody>
        </table>
      </div>

      <h2>{ru ? 'Как проходит день проверки' : 'How a check day goes'}</h2>
      <ol>
        <li><strong>{ru ? 'Реестр регулятора.' : 'Regulator registry.'}</strong> {ru
          ? 'Открываем реестр Curaçao eGaming, MGA или Anjouan и ищем номер, указанный на сайте казино. Если номера в реестре нет, проверка на этом заканчивается.'
          : 'We open the Curaçao eGaming, MGA or Anjouan site and look up the number from the footer. Not in the registry — we stop here.'}</li>
        <li><strong>{ru ? 'Депозит в 100 рублей с реального счёта.' : 'A real 100 ₽ deposit.'}</strong> {ru
          ? 'Пополняем через СБП с телефона. Смотрим, поступили ли деньги за секунды, включился ли бонус и не потребовала ли касса «минимум 500» уже после оплаты.'
          : 'Via SBP, from a phone. We check it lands in seconds, the bonus activates, and the cashier does not retroactively demand "minimum 500".'}</li>
        <li><strong>{ru ? 'Секундомер на выводе.' : 'A stopwatch on withdrawal.'}</strong> {ru
          ? 'Подаём заявку на вывод сразу после короткой игровой сессии и засекаем время до поступления денег. Эта цифра и стоит в карточке в графе «вывод от N минут».'
          : 'A withdrawal request right after a short session. We time it to the money arriving — that figure is the "withdrawal from N min" field in the card.'}</li>
        <li><strong>{ru ? 'RTP по данным провайдера.' : "RTP by the provider's paytable."}</strong> {ru
          ? "Открываем два-три популярных слота и сверяем RTP в игре с официальным значением от Pragmatic Play, NetEnt или Play'n GO. Заниженный RTP — серьёзный повод для сомнений."
          : "We open two or three popular slots and compare in-game RTP with the official Pragmatic, NetEnt or Play'n GO value. A reduced RTP is a red flag."}</li>
        <li><strong>{ru ? 'Правила бонуса — от первой до последней строки.' : 'Bonus terms — in full.'}</strong> {ru
          ? 'Считаем реальный оборот, который нужен для вывода (сумма бонуса, умноженная на вейджер), смотрим предельную ставку при отыгрыше и что произойдёт с депозитом, если от бонуса отказаться.'
          : 'We compute the real turnover to withdraw (bonus × wagering), the max bet while wagering, and what happens to the deposit if the bonus is cancelled.'}</li>
      </ol>

      <h2>{ru ? 'За что казино исключают из рейтинга' : 'What gets a casino removed'}</h2>
      <ul>
        <li>{ru ? 'Ожидание выплаты дольше часа, при этом поддержка не называет причину.' : 'A withdrawal taking over an hour with no explanation from support.'}</li>
        <li>{ru ? 'Вейджер выше x40 или условия бонуса, до которых от кассы не добраться за два шага.' : 'Wagering above 40x, or terms not findable within two clicks of the cashier.'}</li>
        <li>{ru ? 'Номер лицензии, которого нет в реестре регулятора, или игры, запущенные не с серверов провайдера.' : 'A licence number missing from the registry, or a swapped game frame.'}</li>
        <li>{ru ? 'Требование верификации при первом выводе суммы до 5 000 рублей.' : 'Verification demanded on a first withdrawal under 5,000 ₽.'}</li>
      </ul>
      <p>{ru
        ? 'Исключение — это не «минус балл», а удаление из списка до следующей проверки. Поэтому в рейтинге нет площадок с оценкой ниже девяти: то, что не прошло порог, в него просто не попадает.'
        : 'Removal is not "minus a point" but deletion from the list until the next check. That is why no casino in the rating scores below 9: anything that fails the threshold is not shown at all.'}</p>

      <h2>{ru ? 'Откуда берутся цифры' : 'Where the numbers come from and why they never diverge'}</h2>
      <p>{ru
        ? 'Минимальный депозит, время вывода, вейджер, RTP, номер лицензии — все эти значения хранятся в одном месте. Из него формируются карточки на главной странице, страницы площадок, '
        : 'Every value — minimum deposit, withdrawal minutes, wagering, RTP, licence number — lives in one data file. The home-page cards, the casino pages, the '}<a href={localePath(locale, '/methods/')}>{ru ? 'таблица методов' : 'methods table'}</a>{ru ? ' и ' : ' and the '}<a href={localePath(locale, '/glossary/')}>{ru ? 'словарь' : 'glossary'}</a>{ru
        ? '. Любое изменение сразу отражается во всех разделах, поэтому на сайте не бывает расхождений вроде «в карточке 100 рублей, а в таблице 500».'
        : ' are generated from it. One edit changes every page at once, so the site never has "100 ₽ in the card but 500 in the table".'}</p>
      <p>{ru
        ? 'Для сверки используем материалы независимого портала '
        : 'For cross-checks we use the independent portal '}<a href={site.source.url} rel="nofollow" target="_blank">don8play.ru</a>{ru
        ? ': оттуда взяты номера лицензий и заявленный RTP в тех случаях, когда казино не публикует их у себя.'
        : ' — licence numbers and declared RTP come from there where a casino does not publish them in its cashier.'}</p>

      <h2>{ru ? 'Как часто проверяем' : 'How often we check'}</h2>
      <p>{ru
        ? 'Содержательное обновление выходит, когда меняются условия или состав списка. Последнее: '
        : 'A content update happens when terms or the line-up change; the latest: '}<time datetime={site.contentUpdated}>{updatedHuman}</time>{ru
        ? '. Сверка условий в карточках проходит каждый понедельник, дата последней — '
        : '. An automated data check runs every Monday; the latest — '}<time datetime={site.lastVerified}>{verifiedHuman}</time>{ru
        ? ' — указана внизу каждой страницы. Если касса казино показывает одно, а карточка — другое, верить следует кассе: сообщите нам, и мы исправим карточку при ближайшей сверке.'
        : " — is at the bottom of every page. If a casino's cashier says one thing and the card another, the cashier and your screenshot are right: tell us and we fix it at the next check."}</p>

      <h2>{ru ? 'Ссылки на казино и деньги' : 'Casino links and money'}</h2>
      <p>{ru
        ? 'Кнопки «Играть» ведут на сайты казино через трекинговые ссылки: по ним мы считаем переходы, чтобы понимать, какие площадки и условия интересуют читателей. Вознаграждения от казино сайт не получает — это исследовательский проект, и место в рейтинге определяется только критериями, описанными выше.'
        : '"Play" buttons lead to casino sites via tracking links: we count click-throughs to see which casinos and terms readers care about. The site receives no payment from casinos — this is a research project, and a casino\'s position depends only on the criteria described above.'}</p>
      <p>{ru
        ? 'Сайт предназначен только для совершеннолетних. Игра на деньги связана с риском потери средств. Если вы замечаете у себя признаки зависимости, обратитесь на горячую линию помощи игрокам и установите лимиты в настройках аккаунта — такая возможность есть у всех площадок рейтинга.'
        : 'This site is for adults 18+ only; playing for money carries a risk of losing funds. If you notice signs of addiction, contact a gambling helpline and set limits in your casino account — every casino in the rating has them.'}</p>
    </div>
  </div>
</Base>
