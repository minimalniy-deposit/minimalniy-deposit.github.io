---
/** Value positioned against the market range. */
interface Props { min: number; max: number; value: number; prefix?: string; left?: string; mid?: string; right?: string }
const { min, max, value, prefix = 'x', left, mid, right } = Astro.props;
const L = left ?? `${prefix}${min}`, M = mid ?? `${prefix}${value}`, R = right ?? `${prefix}${max}`;
const p = Math.max(0, Math.min(100, ((value - min) / (max - min)) * 100));
---
<div class="o-band">
  <div class="tr"><span class="fill" style={`width:${p.toFixed(1)}%`}></span><span class="dot" style={`left:${p.toFixed(1)}%`}></span></div>
  <div class="lb"><span>{L}</span><b>{M}</b><span>{R}</span></div>
</div>
