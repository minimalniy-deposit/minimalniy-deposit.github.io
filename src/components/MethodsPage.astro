---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import methods from '../data/methods.json';
import limits from '../data/payment-limits.json';
import { rates, hasRates, toUsdt, rateDate, spread, fmtRub } from '../lib/rates';
import { casinos, paymentKeys, acceptsMethod } from '../lib/casinos';
import { useT, fmt, localePath, formatMoney, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);
const ru = locale === 'ru';
const home = localePath(locale, '/');

const known = casinos.filter((c) => c.minDeposit != null && c.withdrawMin != null);
const fastest = [...known].sort((a, b) => a.withdrawMin! - b.withdrawMin! || a.rank - b.rank)[0];
const lowest = [...known].sort((a, b) => a.minDeposit! - b.minDeposit! || a.rank - b.rank)[0];
const label = (k: (typeof paymentKeys)[number]) => (t.methods as any)[k] as string;
const cryptoCasinos = casinos.filter((c) => c.minDeposit != null && c.payments.some((p) => ['usdt','btc','crypto'].includes(p)));
const withCashier = cryptoCasinos.filter((c) => c.cashierUsdtRate != null);
const bestCashier = [...withCashier].sort((a, b) => a.cashierUsdtRate! - b.cashierUsdtRate!)[0];

const url = new URL(localePath(locale, '/methods/'), Astro.site).href;
const ld = {
  '@context': 'https://schema.org', '@type': 'WebPage', name: t.methods.title, url, description: t.methods.metaDesc, inLanguage: locale, dateModified: site.lastVerified,
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.casino.breadcrumbHome, item: new URL(home, Astro.site).href },
    { '@type': 'ListItem', position: 2, name: t.methods.h1, item: url },
  ] },
};
---
<Base {locale} path="/methods/" title={t.methods.title} description={t.methods.metaDesc}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(ld)} /></Fragment>
  <div class="container">
    <nav class="crumbs" aria-label="breadcrumb"><ol><li><a href={home}>{t.casino.breadcrumbHome}</a></li><li aria-current="page">{t.methods.h1}</li></ol></nav>
    <div class="page-head">
      <h1>{t.methods.h1}</h1>
      <p class="lede">{t.methods.intro} <a href={home + '#methods'}>{t.methods.introLink}</a>.</p>
    </div>

    <div class="callouts">
      <div class="callout">{t.methods.fastest}: <b><a href={localePath(locale, `/casino/${fastest.slug}/`)}>{fastest.name}</a></b> — {fmt(t.casino.withdrawFrom, { n: fastest.withdrawMin! })}</div>
      <div class="callout">{t.methods.lowest}: <b><a href={localePath(locale, `/casino/${lowest.slug}/`)}>{lowest.name}</a></b> — {formatMoney(lowest.minDeposit!)}</div>
    </div>

    <h2 class="section-title" style="font-size:1.2rem">{t.methods.matrix}</h2>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead>
          <tr>
            <th>#</th><th>{t.casino.colName}</th><th>{t.casino.colDep}</th><th>{t.casino.colWithdraw}</th><th>RTP</th>
            {paymentKeys.map((k) => <th>{label(k)}</th>)}
          </tr>
        </thead>
        <tbody>
          {casinos.map((c) => (
            <tr>
              <td class="num">{c.rank}</td>
              <td><a href={localePath(locale, `/casino/${c.slug}/`)}>{c.name}</a></td>
              <td class="num">{c.minDeposit != null ? formatMoney(c.minDeposit) : '—'}</td>
              <td class="num">{c.withdrawMin != null ? fmt(t.casino.withdrawFrom, { n: c.withdrawMin }) : '—'}</td>
              <td class="num">{c.rtp != null ? `${c.rtp.toFixed(1)}%` : '—'}</td>
              {paymentKeys.map((k) => acceptsMethod(c, k)
                ? <td class="ok" title={`${c.name}: ${label(k)}`}>{t.methods.yes}</td>
                : <td class="no">{t.methods.no}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="section-sub" style="margin-top:10px">{t.methods.note}</p>

    {hasRates && (
      <section style="margin-top:32px">
        <h2 class="section-title" style="font-size:1.2rem">{t.rates.h}</h2>
        <p class="section-sub">{t.rates.lede}</p>
        <div class="callouts">
          <div class="callout">{t.rates.cbr}: <b>{fmtRub(rates.usd!)} ₽</b> / $ <span class="verified">({fmt(t.rates.asOf, { date: rateDate(ru) })})</span></div>
          <div class="callout">{t.rates.market}: <b>{fmtRub(rates.usdt!)} ₽</b></div>
          <div class="callout">{t.rates.btc}: <b>{fmtRub(rates.btc!)} ₽</b></div>
          {bestCashier && <div class="callout">{t.rates.bestSpread}: <b><a href={localePath(locale, `/casino/${bestCashier.slug}/`)}>{bestCashier.name}</a></b> — +{spread(bestCashier.cashierUsdtRate)}%</div>}
        </div>
        <div class="tbl-wrap">
          <table class="tbl">
            <thead><tr><th>#</th><th>{t.casino.colName}</th><th>{t.rates.colMin}</th><th>{t.rates.colUsdt}</th><th>{t.rates.colCashier}</th><th>{t.rates.colSpread}</th></tr></thead>
            <tbody>{cryptoCasinos.map((c) => (
              <tr>
                <td class="num">{c.rank}</td>
                <td><a href={localePath(locale, `/casino/${c.slug}/`)}>{c.name}</a></td>
                <td class="num">{formatMoney(c.minDeposit!)}</td>
                <td class="num">{toUsdt(c.minDeposit!)} USDT</td>
                <td class="num">{c.cashierUsdtRate != null ? `${fmtRub(c.cashierUsdtRate)} ₽` : <span class="verified">— {t.rates.pending}</span>}</td>
                <td class="num">{c.cashierUsdtRate != null ? `${spread(c.cashierUsdtRate)! > 0 ? '+' : ''}${spread(c.cashierUsdtRate)}%` : '—'}</td>
              </tr>))}</tbody>
          </table>
        </div>
        <p class="section-sub" style="margin-top:10px">{t.rates.note} {fmt(t.rates.sources, { s: rates.sources.join(', ') })}</p>
      </section>
    )}

    <h2 class="section-title" style="font-size:1.2rem;margin-top:32px">{t.facts2.limits}</h2>
    <div class="tbl-wrap"><table class="tbl"><thead><tr><th>{ru ? 'Способ' : 'Method'}</th><th>{ru ? 'Скорость вывода' : 'Withdrawal speed'}</th><th>{ru ? 'Лимит в сутки' : 'Limit'}</th></tr></thead>
      <tbody>{limits.map((l) => <tr><td>{ru ? l.name : l.nameEn}</td><td>{ru ? l.time : l.timeEn}</td><td>{ru ? l.limit : l.limitEn}</td></tr>)}</tbody></table></div>
    <p class="section-sub" style="margin-top:10px">{t.facts2.limitsNote}</p>

    <h2 class="section-title" style="font-size:1.2rem;margin-top:32px">{t.methods.byMethod}</h2>
    <div class="method-groups">
      {paymentKeys.map((k) => (
        <div class="method-group">
          <h3>{label(k)}</h3>
          <ul>{casinos.filter((c) => acceptsMethod(c, k)).map((c) => <li><a href={localePath(locale, `/casino/${c.slug}/`)}>{c.name}</a></li>)}</ul>
        </div>
      ))}
    </div>

    {ru && (
      <section style="padding:32px 0 48px">
        <h2 class="section-title" style="font-size:1.2rem">Скорость по типу способа</h2>
        <div class="method-groups">
          {methods.map((m) => <div class="method-group"><h3>{m.icon} {m.name}</h3><p class="section-sub" style="margin:0">{m.speed}</p></div>)}
        </div>
        <p style="margin-top:16px;font-size:.9rem"><a href={home + '#methods'}>Подробнее о каждом способе — на главной странице →</a></p>
      </section>
    )}
    {!ru && <p style="padding:24px 0 48px"><a href={home + '#rating'}>{t.casino.backToRating}</a></p>}
  </div>
</Base>
