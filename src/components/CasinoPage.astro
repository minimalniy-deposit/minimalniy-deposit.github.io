---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { casinos, mentionsOf, type Casino } from '../lib/casinos';
import { changesFor, observedSince, snapshotsFor } from '../lib/history';
import { series, svgLine } from '../lib/charts';
import GuidesGrid from './GuidesGrid.astro';
import { hasRates, toUsdt, rateDate, spread, fmtRub } from '../lib/rates';
import { useT, fmt, localePath, formatMoney, type Locale } from '../i18n';

import intro from '../content/home/intro.html?raw';
import otherCasinos from '../content/home/other-casinos.html?raw';
import whatIs from '../content/home/what-is.html?raw';
import howto from '../content/home/howto.html?raw';
import slotsBonuses from '../content/home/slots-bonuses.html?raw';
import tips from '../content/home/tips.html?raw';
import faq from '../data/faq.json';

interface Props { c: Casino; locale: Locale }
const { c, locale } = Astro.props;
const t = useT(locale);
const ru = locale === 'ru';
const home = localePath(locale, '/');
const short = c.name.replace(/ Casino$/, '');

const blockNames: Record<string, string> = ru
  ? { intro: 'Вступление', 'other-casinos': 'Другие новые казино', 'what-is': 'Что такое казино с минимальным депозитом', howto: 'Как выбрать', 'slots-bonuses': 'Слоты и бонусы', tips: 'Полезные советы', faq: 'FAQ' }
  : { intro: 'Introduction', 'other-casinos': 'Other new casinos', 'what-is': 'What a minimum-deposit casino is', howto: 'How to choose', 'slots-bonuses': 'Slots and bonuses', tips: 'Tips', faq: 'FAQ' };
const mentions = mentionsOf(c.name, {
  intro, 'other-casinos': otherCasinos, 'what-is': whatIs, howto, 'slots-bonuses': slotsBonuses, tips,
  faq: faq.map((f) => `<p>${f.a}</p>`).join(''),
});
const highlight = (s: string) => s.replace(new RegExp(`(${short})`, 'gi'), '<mark>$1</mark>');

const neighbours = casinos.filter((x) => Math.abs(x.rank - c.rank) <= 1);
const hist = changesFor(c.slug);
const speed = series(c.slug, 'withdrawMin');
const speedSvg = svgLine(speed, { unit: ' мин', invert: true, title: t.fresh.speedH });
const snaps = snapshotsFor(c.slug);
const since = observedSince(c.slug);
const fmtD = (d: string) => new Date(d).toLocaleDateString(ru ? 'ru-RU' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).replace(' г.', '');
const fmtV = (k: string, v: number | null) => v == null ? '—' : k === 'rtp' ? `${v}%` : k === 'cashback' ? `${v}%` : k === 'wager' ? `x${v}` : k === 'minDeposit' ? `${v.toLocaleString('ru-RU')} ₽` : String(v);
const payLabel = ru ? c.paymentsLabel : c.paymentsLabelEn;
const licenseLabel = c.license === 'Anjouan' ? 'Anjouan' : (ru ? 'Кюрасао' : 'Curaçao');
const g = (slug: string) => localePath(locale, '/glossary/') + '#' + slug;

const full = c.minDeposit != null && c.withdrawMin != null;
const title = ru
  ? (full ? `${c.name}: минимальный депозит ${formatMoney(c.minDeposit!, locale)}, вывод от ${c.withdrawMin} минут — ${c.rank}-е место в рейтинге 2026 года` : `${c.name} — ${c.rank}-е место в рейтинге казино с минимальным депозитом 2026 года`)
  : (full ? `${c.name} — minimum deposit ${formatMoney(c.minDeposit!, locale)}, withdrawal from ${c.withdrawMin} min, #${c.rank} in the 2026 rating` : `${c.name} — #${c.rank} in the 2026 minimum-deposit casino rating`);
const bonusText = (ru ? c.bonus : c.bonusEn)?.replace(/<[^>]+>/g, '');
const description = ru
  ? [full ? `${c.name} принимает депозит от ${formatMoney(c.minDeposit!, locale)} (${payLabel}) и выплачивает выигрыш в среднем за ${c.withdrawMin} минут; лицензия ${c.licenseShort ?? licenseLabel}` : `${c.name} работает по лицензии ${licenseLabel} и занимает ${c.rank}-е место в рейтинге`, c.rating != null ? `Оценка — ${c.rating.toFixed(1)} из 10` : null, bonusText].filter(Boolean).join('. ') + '.'
  : [full ? `${c.name}: deposit from ${formatMoney(c.minDeposit!, locale)} via ${payLabel}, withdrawal from ${c.withdrawMin} minutes, ${c.licenseShort ?? licenseLabel} licence` : `${c.name}: ${licenseLabel} licence, #${c.rank} in the rating`, c.rating != null ? `Score ${c.rating.toFixed(1)}/10` : null, bonusText].filter(Boolean).join('. ') + '.';

const pageUrl = new URL(localePath(locale, `/casino/${c.slug}/`), Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title, url: pageUrl, description, inLanguage: locale, dateModified: site.lastVerified,
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.casino.breadcrumbHome, item: new URL(home, Astro.site).href },
    { '@type': 'ListItem', position: 2, name: t.casino.breadcrumbRating, item: new URL(home + '#rating', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: c.name, item: pageUrl },
  ] },
};
const verifiedHuman = new Date(site.lastVerified).toLocaleDateString(ru ? 'ru-RU' : 'en-GB');
---
<Base {locale} path={`/casino/${c.slug}/`} {title} {description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </Fragment>

  <div class="container">
    <nav class="crumbs" aria-label="breadcrumb">
      <ol>
        <li><a href={home}>{t.casino.breadcrumbHome}</a></li>
        <li><a href={home + '#rating'}>{t.casino.breadcrumbRating}</a></li>
        <li aria-current="page">{c.name}</li>
      </ol>
    </nav>

    <div class="page-head">
      <span class="rank-chip"><b>#{c.rank}</b> {t.casino.rankIn} {fmt(t.casino.of10, { n: casinos.length })}{c.rating != null && <> · {c.stars} {c.rating.toFixed(1)} · {c.reviews?.toLocaleString(ru ? 'ru-RU' : 'en-US')} {t.casino.reviews}</>}</span>
      <h1>{c.name}</h1>
      <p class="lede">{description}</p>
    </div>

    <h2 class="section-title" style="font-size:1.2rem">{t.casino.facts}</h2>
    <dl class="facts">
      <div class="fact"><dt>{t.casino.minDeposit}</dt><dd class="gold">{c.minDeposit != null ? formatMoney(c.minDeposit, locale) : '—'}{c.minDeposit != null && [100, 500, 1000].includes(c.minDeposit) && <> <a class="verified" href={localePath(locale, `/deposit/${c.minDeposit}/`)}>{ru ? 'что даёт эта сумма →' : 'what this sum buys →'}</a></>}</dd></div>
      <div class="fact"><dt>{t.casino.withdraw}</dt><dd>{c.withdrawMin != null ? fmt(t.casino.withdrawFrom, { n: c.withdrawMin }) : '—'}{c.withdrawMin != null && <> <a class="verified" href={localePath(locale, '/fast-withdrawal/')}>{ru ? 'сравнить →' : 'compare →'}</a></>}</dd></div>
      <div class="fact"><dt>{t.casino.payments}</dt><dd>{payLabel ? payLabel.split(' · ').map((lbl, i) => { const k = /СБП|SBP/.test(lbl) ? 'sbp' : /Карта|Card/.test(lbl) ? 'card' : 'crypto'; return <>{i > 0 && ' · '}<a href={localePath(locale, `/methods/${k}/`)} style="color:inherit">{lbl}</a></>; }) : '—'}</dd></div>
      <div class="fact"><dt>{t.casino.license}</dt><dd>{c.licenseShort ?? licenseLabel}{c.licenseVerifyUrl ? <> <a class="verified" href={c.licenseVerifyUrl} rel="noopener" target="_blank">{t.fresh.verify} →</a></> : <> <a class="verified" href={c.license === 'Anjouan' ? 'https://anjouangaming.com/public-register/' : 'https://www.cga.cw/en/133i348441001'} rel="noopener" target="_blank" title={t.fresh.verifyHow}>{t.fresh.verify} →</a></>}</dd></div>
      {c.rtp != null && <div class="fact"><dt><a href={g('rtp')}>{t.facts2.rtp}</a></dt><dd class="gold">{c.rtp.toFixed(1)}%</dd></div>}
      {hasRates && c.minDeposit != null && c.payments.some((p) => ['usdt','btc','crypto'].includes(p)) && <div class="fact"><dt>{t.casino.minDeposit} · USDT</dt><dd>{toUsdt(c.minDeposit)} USDT <span class="verified">({fmt(t.rates.asOf, { date: rateDate(ru) })})</span></dd></div>}
      {c.cashierUsdtRate != null && hasRates && <div class="fact"><dt>{t.rates.colCashier}</dt><dd>{fmtRub(c.cashierUsdtRate)} ₽ <span class="verified">({spread(c.cashierUsdtRate)! > 0 ? '+' : ''}{spread(c.cashierUsdtRate)}% {ru ? 'к рынку' : 'vs market'})</span></dd></div>}
      {c.wager != null && <div class="fact"><dt><a href={g('wager')}>{t.facts2.wager}</a></dt><dd>x{c.wager}</dd></div>}
      {c.cashback != null && <div class="fact"><dt><a href={g('cashback')}>{t.facts2.cashback}</a></dt><dd>{ru ? 'до' : 'up to'} {c.cashback}%</dd></div>}
    </dl>
    {c.features.length > 0 && <div class="card-pills" style="margin:4px 0 8px">{c.features.map((f) => <span class="pill">{f}</span>)}</div>}
    {c.licenseFull && <p class="verified" style="margin:4px 0 12px">{t.facts2.licenseFull}: {c.licenseFull}</p>}

    {(ru ? c.bonus : c.bonusEn) && <div class="bonus-box">
      <p set:html={ru ? c.bonus : c.bonusEn} />
      {c.promoCode && <p style="margin-top:8px">{t.casino.promoCode}: <code class="promo-code">{c.promoCode}</code></p>}
    </div>}

    <div class="cta-row">
      <a href={c.url} rel="nofollow noopener" target="_blank" class="btn-go">{fmt(t.casino.goto, { name: c.name })}</a>
      <span class="verified">{t.casino.verified}: <time datetime={site.lastVerified}>{verifiedHuman}</time></span>
    </div>

    {mentions.length > 0 && (
      <section style="padding:24px 0">
        <h2 class="section-title" style="font-size:1.2rem">{t.casino.mentions}</h2>
        <p class="section-sub">{fmt(t.casino.mentionsNote, { name: c.name })}</p>
        <div class="mentions">
          {mentions.map((m) => (
            <blockquote lang="ru">
              <span set:html={highlight(m.text)} />
              <cite><a href={home + (m.block === 'faq' ? '#faq' : m.block === 'howto' ? '#howto' : '#rating')}>{blockNames[m.block]}</a></cite>
            </blockquote>
          ))}
        </div>
      </section>
    )}

    {since && (
      <section style="padding:24px 0 0">
        <h2 class="section-title" style="font-size:1.2rem">{t.history.h}</h2>
        <p class="section-sub">{fmt(t.history.since, { d: fmtD(since) })}{hist.length <= 1 ? ` — ${t.history.noChanges}.` : '.'} {t.history.weekly}</p>
        {speedSvg && <div style="margin:8px 0 12px"><p class="section-sub" style="margin-bottom:4px">{t.fresh.speedH} — {t.fresh.speedSub}</p><Fragment set:html={speedSvg} /></div>}
        <div class="tbl-wrap" data-hint={ru ? 'таблица прокручивается →' : 'scroll the table →'}>
          <table class="tbl">
            <tbody>
              {hist.map((h, i) => (
                <tr>
                  <td class="num" style="white-space:nowrap"><time datetime={h.date}>{fmtD(h.date)}</time></td>
                  <td style="white-space:normal">{i === 0
                    ? h.diffs.map((d) => `${(t.history.k as any)[d.key]}: ${fmtV(d.key, d.to)}`).join(' · ') + ` (${t.history.first})`
                    : h.diffs.map((d) => d.from == null ? `${(t.history.k as any)[d.key]}: ${fmtV(d.key, d.to)} (${t.history.added})` : `${(t.history.k as any)[d.key]}: ${fmtV(d.key, d.from)} → ${fmtV(d.key, d.to)}`).join(' · ')}</td>
                  <td style="white-space:normal;color:var(--muted);font-size:.8rem">{h.source}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {snaps.length > 0 && <p class="section-sub" style="margin-top:10px">{t.fresh.snap}: {snaps.map((sn, i) => <>{i > 0 && ' · '}<a href={sn.snapshot} rel="noopener" target="_blank">{fmtD(sn.date)}</a></>)} — {t.fresh.snapSub.toLowerCase()}.</p>}
      </section>
    )}

    <section style="padding:24px 0 48px">
      <h2 class="section-title" style="font-size:1.2rem">{t.casino.compare}</h2>
      <div class="tbl-wrap" data-hint={ru ? 'таблица прокручивается →' : 'scroll the table →'}>
        <table class="tbl">
          <thead><tr><th>#</th><th>{t.casino.colName}</th><th>{t.casino.colDep}</th><th>{t.casino.colWithdraw}</th><th>{t.casino.colPay}</th><th>{t.casino.rating}</th></tr></thead>
          <tbody>
            {neighbours.map((n) => (
              <tr class:list={{ me: n.slug === c.slug }}>
                <td class="num">{n.rank}</td>
                <td>{n.slug === c.slug ? n.name : <a href={localePath(locale, `/casino/${n.slug}/`)}>{n.name}</a>}</td>
                <td class="num">{n.minDeposit != null ? formatMoney(n.minDeposit, locale) : '—'}</td>
                <td class="num">{n.withdrawMin != null ? fmt(t.casino.withdrawFrom, { n: n.withdrawMin }) : '—'}</td>
                <td>{(ru ? n.paymentsLabel : n.paymentsLabelEn) ?? '—'}</td>
                <td class="num">{n.rating != null ? n.rating.toFixed(1) : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="margin-top:16px"><a href={home + '#rating'}>{t.casino.backToRating}</a></p>
    </section>

    <GuidesGrid {locale} compact />
    <div class="disclaimer" style="margin-bottom:48px" set:html={ru
      ? '<strong>Важно.</strong> Азартные игры предназначены только для совершеннолетних. Игра на деньги связана с риском финансовых потерь. Ссылки на казино — трекинговые: по ним подсчитываются переходы для исследования, вознаграждения от казино сайт не получает. За действия операторов сайт ответственности не несёт. Если вы замечаете у себя признаки игровой зависимости, обратитесь на горячую линию помощи игрокам. Материал носит справочный характер и не является офертой или рекламой. В Российской Федерации организация азартных игр в интернете запрещена законом. Сайт предназначен для читателей из других стран СНГ, где онлайн-казино разрешены и работают легально; перед игрой убедитесь, что это допускает законодательство вашей страны.'
      : '<strong>⚠️ Important:</strong> Gambling is for adults 18+ only. Playing for money carries a risk of financial loss. Casino links are tracking links used to count click-throughs for research; the site receives no payment from casinos. This site is not responsible for the actions of third parties. If you notice signs of gambling addiction, contact a gambling helpline. This material is informational and is not an offer or advertisement. Online gambling is prohibited by law in the Russian Federation. This site is intended for readers in other CIS countries where online casinos are permitted and operate legally; make sure the laws of your country allow it before playing.'} />
  </div>
</Base>
