---
/** ASCII radar behind the content, on every page. The canvas stays empty until the page is idle:
 *  the renderer (lib/asciiRadar.ts) is a separate chunk pulled in on requestIdleCallback after `load`,
 *  so it never competes with fonts, the hero video or Metrika. Fades in on first frame.
 *  Mobile: bigger cells, 15 fps, dpr 1, lower opacity. Reduced motion / Save-Data / ≤2 GB RAM: one static frame. */
---
<canvas class="ascii-radar" aria-hidden="true"></canvas>
<style>
  .ascii-radar { position: fixed; inset: 0; z-index: -1; width: 100%; height: 100%; pointer-events: none; opacity: 0; transition: opacity 1.6s ease; contain: strict; }
  .ascii-radar.is-on { opacity: var(--radar-opacity, .9); }
  @media (max-width: 720px) { .ascii-radar.is-on { opacity: var(--radar-opacity-m, .75); } }
  @media print { .ascii-radar { display: none; } }
</style>
<script>
  const el = document.querySelector<HTMLCanvasElement>('canvas.ascii-radar');
  const nav = navigator as Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number };
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches || !!nav.connection?.saveData || (nav.deviceMemory != null && nav.deviceMemory <= 2);
  const mobile = matchMedia('(max-width: 720px), (pointer: coarse)').matches;
  const boot = () => { if (el) import('../lib/asciiRadar').then((m) => m.start(el, { mobile, reduced })).catch(() => {}); };
  const idle = (cb: () => void) => {
    const w = window as Window & { requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => number };
    w.requestIdleCallback ? w.requestIdleCallback(cb, { timeout: 4000 }) : setTimeout(cb, 1500);
  };
  // prerendered (speculation rules) or background tabs wait until they are actually shown
  const go = () => (document.hidden ? document.addEventListener('visibilitychange', () => { if (!document.hidden) idle(boot); }, { once: true }) : idle(boot));
  document.readyState === 'complete' ? go() : addEventListener('load', go, { once: true });
</script>
